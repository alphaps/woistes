@page "/upload"
@using Woistes.CtfParser
@using Woistes.Domain
@inject ICtfParser Parser
@inject ICatalogueRepository Repository
@inject NavigationManager Navigation

<h1>Upload CTF File</h1>

<div class="upload-area">
    <InputFile OnChange="HandleFileSelected" accept=".ctf,.CTF" />
</div>

@if (_message != null)
{
    <p class="upload-message @(_isError ? "error" : "success")">@_message</p>
}

@code {
    private string? _message;
    private bool _isError;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _message = null;
        var file = e.File;

        if (file.Size > 50 * 1024 * 1024)
        {
            _message = "File too large (max 50 MB).";
            _isError = true;
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var catalogue = Parser.Parse(ms, file.Name);
            catalogue.ImportedDate = DateTime.UtcNow;
            await Repository.AddAsync(catalogue);

            Navigation.NavigateTo($"/browse/{catalogue.Id}");
        }
        catch (Exception ex)
        {
            _message = $"Parse error: {ex.Message}";
            _isError = true;
        }
    }
}
