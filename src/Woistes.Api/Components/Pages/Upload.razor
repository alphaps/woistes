@page "/upload"
@using Woistes.CtfParser
@using Woistes.Domain
@inject ICtfParser Parser
@inject ICatalogueRepository Repository
@inject NavigationManager Navigation

<h1>Upload CTF File</h1>

<div class="upload-area">
    <InputFile OnChange="HandleFileSelected" accept=".ctf,.CTF" />
</div>

@if (_loading)
{
    <p>@_status</p>
    @if (_progress is { EntriesTotal: > 0 })
    {
        var pct = (int)(100.0 * _progress.EntriesSaved / _progress.EntriesTotal);
        <div class="progress-bar">
            <div class="progress-fill" style="width:@(pct)%"></div>
        </div>
        <p class="progress-text">
            Disk @_progress.DisksSaved / @_progress.DisksTotal &mdash;
            @_progress.EntriesSaved.ToString("N0") / @_progress.EntriesTotal.ToString("N0") entries (@pct%)
        </p>
    }
}

@if (_message != null)
{
    <p class="upload-message @(_isError ? "error" : "success")">@_message</p>
}

@code {
    private string? _message;
    private bool _isError;
    private bool _loading;
    private string _status = "";
    private ImportProgress? _progress;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _message = null;
        _progress = null;
        _loading = true;
        _status = "Parsing...";
        StateHasChanged();
        await Task.Yield();
        var file = e.File;

        if (file.Size > 50 * 1024 * 1024)
        {
            _message = "File too large (max 50 MB).";
            _isError = true;
            _loading = false;
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var catalogue = Parser.Parse(ms, file.Name);
            catalogue.ImportedDate = DateTime.UtcNow;

            _status = "Saving...";
            // InvokeAsync marshals the progress callback onto the render thread.
            var progress = new Progress<ImportProgress>(p =>
                _ = InvokeAsync(() => { _progress = p; StateHasChanged(); }));
            await Repository.AddAsync(catalogue, progress);

            Navigation.NavigateTo($"/browse/{catalogue.Id}");
        }
        catch (Exception ex)
        {
            _message = $"Parse error: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _loading = false;
        }
    }
}
