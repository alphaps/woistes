@page "/"
@using Microsoft.JSInterop
@using Woistes.Domain
@inject ICatalogueRepository Repository
@inject IJSRuntime JS

<h1>Catalogues</h1>

@if (_catalogues == null)
{
    <p>Loading...</p>
}
else if (_catalogues.Count == 0)
{
    <p>No catalogues imported yet. <a href="/upload">Upload a CTF file</a> to get started.</p>
}
else
{
    <table class="catalogue-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Disks</th>
                <th>Files</th>
                <th>Folders</th>
                <th>Imported</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _catalogues)
            {
                <tr>
                    <td><a href="/browse/@c.Id">@c.Name</a></td>
                    <td>@c.Disks.Count</td>
                    <td>@c.FileCount</td>
                    <td>@c.FolderCount</td>
                    <td>@c.ImportedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (_deletingId == c.Id)
                        {
                            <button disabled>Deleting...</button>
                        }
                        else
                        {
                            <button class="btn-danger" @onclick="() => Delete(c.Id)">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Catalogue>? _catalogues;
    private int? _deletingId;

    protected override async Task OnInitializedAsync()
    {
        _catalogues = await Repository.GetAllAsync();
    }

    private async Task Delete(int id)
    {
        var name = _catalogues?.FirstOrDefault(c => c.Id == id)?.Name ?? "this catalogue";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete \"{name}\" and all its entries?");
        if (!confirmed) return;

        _deletingId = id;
        await Task.Yield();
        await Repository.DeleteAsync(id);
        _deletingId = null;
        _catalogues = await Repository.GetAllAsync();
    }
}
